{
    "name": "webong/gouge",
    "type": "library",
    "description": "Grimoire's Laravel AI runtime implementation",
    "require": {
        "php": "^8.3",
        "laravel/ai": "^0.10.1",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/bus": "^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Gouge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Gouge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webong\\Gouge\\GougeServiceProvider"
            ]
        },
        "grimoire": {
            "kind": "runtime-implementation",
            "sdk": "laravel-ai"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.6|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "scripts": {
        "test": "phpunit"
    }
}

{
    "name": "webong/gouge",
    "type": "library",
    "description": "Grimoire's Laravel AI runtime implementation",
    "require": {
        "php": "^8.2",
        "laravel/ai": "^0.10.1",
        "laravel/mcp": "^0.9.1",
        "sajya/client": "^1.4",
        "sajya/server": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Webong\\Gouge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webong\\Gouge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webong\\Gouge\\GougeServiceProvider"
            ]
        },
        "grimoire": {
            "kind": "runtime-implementation",
            "sdk": "laravel-ai"
        }
    }
}

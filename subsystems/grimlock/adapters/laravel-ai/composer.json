{
  "name": "grimoire/grimlock-laravel-ai",
  "version": "0.1.0",
  "description": "Grimoire's Grimlock subsystem integration for Laravel AI-managed agents, skills, clients, devices, and connectors.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^12.0",
    "illuminate/database": "^12.0",
    "illuminate/support": "^12.0",
    "laravel/ai": "^0.10.1"
  },
  "autoload": {
    "psr-4": {
      "Grimlock\\LaravelAi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Grimlock\\LaravelAi\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Grimlock\\LaravelAi\\GrimlockServiceProvider"
      ]
    }
  }
}
